        "jsCode": "const staticData = this.getWorkflowStaticData('global');\nif (!staticData.seenApplicants) staticData.seenApplicants = {};\nif (!staticData.openApplicants) staticData.openApplicants = {};\nconst allowedStatuses = [40, 50, 80, 82, 121];\nconst applicants = $json.applicants || [];\nconst output = [];\nfor (const applicant of applicants) {\n  const applicantNo = String(applicant.applicantNumber);\n  if (!allowedStatuses.includes(Number(applicant.applicantStatus))) continue;\n  if (staticData.seenApplicants[applicantNo]) continue;\n  staticData.seenApplicants[applicantNo] = new Date().toISOString();\n  staticData.openApplicants[applicantNo] = {\n    applicantStatus: Number(applicant.applicantStatus),\n    bankResponseEndDate: applicant.bankResponseEndDate || null,\n    decisionTopic: applicant.decisionTopic || null,\n    approvalPending: true,\n    updatedAt: new Date().toISOString()\n  };\n  output.push({ json: applicant });\n}\nreturn output;"
