    {
      "parameters": {
        "jsCode": "const staticData = this.getWorkflowStaticData('global');\nconst cfg = $item(0).$node['Konfigurasyon'].json;\nconst warnHours = Number(cfg.slaWarnHour || 24);\nconst now = new Date();\nconst rows = [];\nfor (const [applicantNumber, row] of Object.entries(staticData.openApplicants || {})) {\n  const endDate = row.bankResponseEndDate ? new Date(row.bankResponseEndDate) : null;\n  const diffHour = endDate ? (endDate.getTime() - now.getTime()) / (1000 * 60 * 60) : null;\n  rows.push({\n    applicantNumber,\n    applicantStatus: row.applicantStatus,\n    approvalPending: Boolean(row.approvalPending),\n    bankResponseEndDate: row.bankResponseEndDate,\n    hoursToDeadline: diffHour,\n    critical: diffHour !== null && diffHour < 0,\n    warning: diffHour !== null && diffHour >= 0 && diffHour <= warnHours\n  });\n}\nconst criticalCount = rows.filter(r => r.critical).length;\nconst warningCount = rows.filter(r => r.warning).length;\nconst pendingApprovalCount = rows.filter(r => r.approvalPending).length;\nreturn [{ json: { rows, criticalCount, warningCount, pendingApprovalCount } }];"
      },
